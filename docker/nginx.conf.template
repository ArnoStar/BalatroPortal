# The site's front door: the portal at /, and the other parts on the same
# origin, so that they share the player's session (localStorage) and need no
# CORS:
#   /play/      the game (BalatroFrontEnd's container)        GAME_UPSTREAM
#   /api/       the game API (BalatroWebAPI)                  API_UPSTREAM
#   /identity/  the identity service, without the /identity   IDENTITY_UPSTREAM
# The upstreams are origins (http://host:port), looked up again as containers
# are redeployed (RESOLVER: Docker's DNS by default).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/octet-stream;

    resolver ${RESOLVER} valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /play/ {
        set $game_upstream ${GAME_UPSTREAM};
        proxy_pass $game_upstream;
    }

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
    }

    location /identity/ {
        set $identity_upstream ${IDENTITY_UPSTREAM};
        rewrite ^/identity/(.*)$ /$1 break;
        proxy_pass $identity_upstream;
    }

    # Vite's hashed bundles never change
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        # (add_header here replaces the server's: each location lists its own)
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ /index.html;
    }
}
