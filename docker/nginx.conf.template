# The site's front door: the portal at /, and the other parts on the same
# origin, so that they share the player's session (localStorage) and need no
# CORS:
#   /play/      the game (BalatroFrontEnd's container)        GAME_UPSTREAM
#   /casino/    the casino (BalatroCasino's container)         CASINO_UPSTREAM
#   /api/       the game API (BalatroWebAPI)                  API_UPSTREAM
#   /identity/  the identity service, without the /identity   IDENTITY_UPSTREAM
#   /reports/   the bug report service, without the /reports  REPORTS_UPSTREAM
#   /items/     the item service, without the /items          ITEMS_UPSTREAM
#   /social/    the social service, without the /social       SOCIAL_UPSTREAM
# The upstreams are origins (http://host:port), looked up again as containers
# are redeployed (RESOLVER: Docker's DNS by default).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/octet-stream;

    resolver ${RESOLVER} valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /play/ {
        set $game_upstream ${GAME_UPSTREAM};
        proxy_pass $game_upstream;
    }

    # the casino: its own app (its old address here, /casino?tab=..., lands there too)
    location /casino/ {
        set $casino_upstream ${CASINO_UPSTREAM};
        proxy_pass $casino_upstream;
    }

    location = /casino {
        return 301 /casino/$is_args$args;
    }

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
    }

    # the bug report service: reports carry a recording and a screenshot (larger
    # bodies); it is told where it is mounted (its screenshot links)
    location /reports/ {
        set $reports_upstream ${REPORTS_UPSTREAM};
        rewrite ^/reports/(.*)$ /$1 break;
        client_max_body_size 25m;
        # (a proxy_set_header here replaces the server's: all of them again)
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /reports;
        proxy_pass $reports_upstream;
    }

    # the item service (BalatroItemService): the players' items, trades and casino
    location /items/ {
        set $items_upstream ${ITEMS_UPSTREAM};
        rewrite ^/items/(.*)$ /$1 break;
        proxy_pass $items_upstream;
    }

    # the casino's live stream (server-sent events): passed on as it comes, as the social service's
    location /items/v1/casino/live {
        set $items_upstream ${ITEMS_UPSTREAM};
        rewrite ^/items/(.*)$ /$1 break;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_pass_header X-Accel-Buffering;
        proxy_pass $items_upstream;
    }

    # the social service (BalatroSocial): friends and chat. Its event stream
    # (/social/v1/events) stays open and goes on as it comes: no buffering here,
    # and X-Accel-Buffering passed on, so that a proxy in front doesn't buffer it either
    location /social/ {
        set $social_upstream ${SOCIAL_UPSTREAM};
        rewrite ^/social/(.*)$ /$1 break;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_pass_header X-Accel-Buffering;
        proxy_pass $social_upstream;
    }

    location /identity/ {
        set $identity_upstream ${IDENTITY_UPSTREAM};
        rewrite ^/identity/(.*)$ /$1 break;
        proxy_pass $identity_upstream;
    }

    # Vite's hashed bundles never change
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        # (add_header here replaces the server's: each location lists its own)
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ /index.html;
    }
}
